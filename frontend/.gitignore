# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# VAD / ONNX Runtime assets copied out of node_modules by scripts/copy-vad-assets.js.
# Build artifacts (~13 MB of wasm) — regenerated by the prebuild hook, never commit.
# Note `npm run dev` does NOT trigger prebuild, so run the script by hand for local dev.
/public/vad.worklet.bundle.min.js
/public/silero_vad_legacy.onnx
/public/ort*.wasm
/public/ort*.mjs
