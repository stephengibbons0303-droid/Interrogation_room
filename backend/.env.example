# ─── LLM ──────────────────────────────────────────────────────────────────────
# Used by agent.py for the detective dialogue (gpt-4o) AND for the Chroma
# embeddings (text-embedding-3-small) that back contradiction detection.
# Without it the agent falls back to Mock Mode - it will still run, but the
# detectives return a canned placeholder line instead of real interrogation.
# Get one here: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ─── Speech (local, no API keys) ──────────────────────────────────────────────
# Speech runs entirely locally on speech pair C - see backend/speech/.
# Start them with the shared voice venv interpreter:
#   "%USERPROFILE%\.claude\voice\.venv\Scripts\python.exe" backend\speech\stt_server.py
#   "%USERPROFILE%\.claude\voice\.venv\Scripts\python.exe" backend\speech\tts_server.py
# Both are OpenAI-compatible, so pointing these at a hosted provider is a URL change.
# Defaults shown; override only if you move the sidecars.
STT_URL=http://127.0.0.1:7677/v1/audio/transcriptions
TTS_URL=http://127.0.0.1:7678/v1/audio/speech

# ─── Server ───────────────────────────────────────────────────────────────────
# 8013 is this repo's reserved backend port (see CLAUDE.md / ~/.claude/PORTS.md).
# main.py defaults to 8000, so set this explicitly for local dev.
PORT=8013

# NOTE: DEEPGRAM_API_KEY is no longer required. STT moved from Deepgram nova-2 to
# a local faster-whisper large-v3 sidecar (better on non-native accented English).
