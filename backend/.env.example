# ─── LLM ──────────────────────────────────────────────────────────────────────
# agent.py picks a provider in this order: Azure OpenAI -> OpenAI -> Mock Mode.
# In Mock Mode it still runs, but the detectives return a canned placeholder.

# Option A: Azure OpenAI (what this project uses; mirrors SAIF's config).
# DEPLOYMENT is the Azure deployment name, not an OpenAI model name.
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_API_KEY=...

# Option B: plain OpenAI.
# OPENAI_API_KEY=sk-...

# ─── Embeddings (contradiction detection) ─────────────────────────────────────
# The Chroma vector memory that lets the detectives catch inconsistencies needs
# embeddings. On Azure that is a SEPARATE deployment from the chat model - if you
# have one, name it here and it takes precedence.
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
#
# With none configured, agent.py falls back to a local ONNX MiniLM bundled with
# chromadb: no key, no cost, ~80 MB fetched once. Lower quality than
# text-embedding-3-small but adequate for surfacing prior statements.
#
# NOTE: collections are namespaced per embedding backend
# (interrogation_memory_azure / _openai / _local). Chroma fixes a collection's
# dimensionality at creation and these models disagree (384 vs 1536), so sharing
# one collection fails on every write.

# ─── Speech (local, no API keys) ──────────────────────────────────────────────
# Speech runs entirely locally on speech pair C - see backend/speech/.
# Start them with the shared voice venv interpreter:
#   "%USERPROFILE%\.claude\voice\.venv\Scripts\python.exe" backend\speech\stt_server.py
#   "%USERPROFILE%\.claude\voice\.venv\Scripts\python.exe" backend\speech\tts_server.py
# Both are OpenAI-compatible, so pointing these at a hosted provider is a URL change.
# Defaults shown; override only if you move the sidecars.
STT_URL=http://127.0.0.1:7677/v1/audio/transcriptions
TTS_URL=http://127.0.0.1:7678/v1/audio/speech

# ─── Server ───────────────────────────────────────────────────────────────────
# 8013 is this repo's reserved backend port (see CLAUDE.md / ~/.claude/PORTS.md).
# main.py defaults to 8000, so set this explicitly for local dev.
PORT=8013

# NOTE: DEEPGRAM_API_KEY is no longer required. STT moved from Deepgram nova-2 to
# a local faster-whisper large-v3 sidecar (better on non-native accented English).
